{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Gynocamp (Chrome - Persistent Port 5000)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=5000",
        "--web-browser-flag=--user-data-dir=${workspaceFolder}/.chrome_dev_data"
      ]
    },
    {
      "name": "Gynocamp (Windows Desktop - Persistent SQLite Disk)",
      "request": "launch",
      "type": "dart",
      "deviceId": "windows"
    },
    {
      "name": "Gynocamp (Android Real Device RMX3269)",
      "request": "launch",
      "type": "dart",
      "deviceId": "1B04293210NA0SCT",
      "args": [
        "--dart-define", "CENTRAL_SERVER_URL=http://192.168.110.108:8080"
      ]
    }
  ]
}
