# ==============================================================================
# GynoCamp SERVER environment template  (copy to `server.env` or set in your host)
# ==============================================================================
# These are SERVER-ONLY secrets read by bin/server.dart.
# NEVER pass them to Flutter via --dart-define and NEVER commit real values.
# Production: inject as runtime environment variables / secret manager
# (docker run --env-file, Compose secrets, host dashboard, Secret Manager, ...).

# --- Cloud OCR (Gemini). Required for cloud OCR; if empty, apps fall back to offline OCR.
GEMINI_API_KEY=

# --- PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=gynocamp_db
PGUSER=postgres
PGPASSWORD=change-me

# --- SMTP (staff "Forgot Password" emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=GynoCamp Security Network
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# --- Network
PORT=8080
HOST=0.0.0.0
